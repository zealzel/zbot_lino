
# single 
(assume the robot type is lino2 and roobt namespace is empty)
ros2 launch fitrobot map.launch.py sim:=true \
  worldname:=turtlebot3_world|turtlebot3_house|room_with_tags|obstacles \
  robot:=lino2 use_mask:=true|false
ros2 launch fitrobot map.launch.py sim:=true worldname:=turtlebot3_world
ros2 launch linorobot2_gazebo sim.launch.py worldname:=turtlebot3_world
ros2 launch linorobot2_navigation nav.launch.py sim:=true rviz:=true worldname:=turtlebot3_world

# multi
(assume the robot type is lino2 and roobt namespace is /robot1 or /robot2)
ros2 launch fitrobot map.launch.py sim:=true \
  worldname:=turtlebot3_world|turtlebot3_house|room_with_tags|obstacles \
  robot:=lino2 use_mask:=false|true
ros2 launch fitrobot map.launch.py sim:=true worldname:=turtlebot3_world robot:=lino2
ros2 launch linorobot2_gazebo sim_multi.launch.py worldname:=turtlebot3_world
ros2 launch linorobot2_navigation nav.launch.py sim:=true rviz:=true worldname:=turtlebot3_world namespace:=/robot1
